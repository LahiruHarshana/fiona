# Public production origin for canonical URLs, Open Graph images and JSON-LD url.
# HTTPS only, no trailing slash, never localhost or a preview host.
# A URL here is not proof of domain ownership. Leave unset until the owner
# confirms the live hostname in writing. Unset = noindex and empty sitemap.
# NEXT_PUBLIC_SITE_URL=https://www.confirmed-production-domain.tld
#
# Server-only indexing gate for non-Vercel hosts. Never prefix with NEXT_PUBLIC_.
# Vercel production (VERCEL_ENV=production) does not need this flag.
# Preview and development deployments stay noindex even if SITE_URL is set.
# SEARCH_INDEXING_ENABLED=true
